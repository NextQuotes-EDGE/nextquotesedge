# GitHub OAuth for Decap CMS admin
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Resend for the contact form
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY="your-resend-api-key"
# Must be a verified domain/email in Resend
CONTACT_FROM_EMAIL="onboarding@resend.dev"
# Where contact form messages arrive
CONTACT_TO_EMAIL="you@yourdomain.com"
# Resend template used to auto-reply to submitters (optional)
CONTACT_CONFIRM_TEMPLATE_ID="your-template-id"
